# Writes ${OUT} (build_id.c) with the git short sha of the source tree, re-run on every build so the exe's
# first log line (`[port] build <sha> <date>`) says which checkout it came from.  "unknown" without git;
# a "+" suffix when tracked files are modified.
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
  set(sha "unknown")
else()
  execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE dirty ERROR_QUIET)
  if(NOT dirty STREQUAL "")
    set(sha "${sha}+")
  endif()
endif()
set(text "/* generated by port/cmake/build_id.cmake */\nconst char port_build_id[] = \"${sha}\";\nconst char port_build_date[] = __DATE__ \" \" __TIME__;\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
